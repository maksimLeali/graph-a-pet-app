{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
        "@config": ["./src/config"],
        "@components": ["./src/components"],
        "@contexts": ["./src/contexts"],
        "@graphql_generated/*": ["./src/components/operations/__generated__/*"],
        "@hooks": ["./src/hooks"],
        "@i18n": ["./src/i18n"],
        "@images": ["./src/images"],
        "@layouts": ["./src/layouts"],
        "@theme": ["./src/theme"],
        "@types": ["./src/types"],
        "@utils": ["./src/utils"],
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
